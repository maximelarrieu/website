{
  "name": "elite-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "deploy": "gcloud run deploy elite-fullstack-portfolio --source . --region us-west1"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@keystatic/core": "^0.5.51",
    "express": "^5.2.1",
    "framer-motion": "^12.4.3",
    "lucide-react": "^0.475.0",
    "marked": "^18.0.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.1",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
